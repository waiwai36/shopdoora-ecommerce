@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var isLoggedIn = !string.IsNullOrEmpty(session?.GetString("JWToken"));
    var userEmail = session?.GetString("UserEmail");
    var userRole = session?.GetString("UserRole");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShopDoora Admin</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ShopDoora.Web.styles.css" asp-append-version="true" />
</head>
<body>

    <div class="d-flex">
        @if (isLoggedIn)
        {
            <nav id="sidebar">
                <div class="sidebar-header text-center">
                    <i class="bi bi-shop text-primary"></i> ShopDoora Panel
                </div>
                <ul class="list-unstyled components">
                    <li class="nav-item">
                        <a asp-controller="Products" asp-action="Index">
                            <i class="bi bi-box-seam"></i> Products
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Orders" asp-action="Index">
                            <i class="bi bi-cart-check"></i> Orders
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Orders" asp-action="Create">
                            <i class="bi bi-bag-plus"></i> Place Order
                        </a>
                    </li>
                    @if (userRole == "Admin")
                    {
                        <li class="nav-item">
                            <a asp-controller="Products" asp-action="Create">
                                <i class="bi bi-plus-circle"></i> Add Product
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

        <!-- Main Wrapper -->
        <div id="content">
            <!-- Top Navbar -->
            <nav class="navbar navbar-expand navbar-top px-4 py-3">
                <div class="container-fluid">
                    <span class="navbar-brand mb-0 h5 text-secondary">
                        @(isLoggedIn ? $"Welcome, {userEmail} ({userRole})" : "ShopDoora System")
                    </span>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-Item me-2">
                                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">Login</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-sm">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </nav>

            <!-- Page Body Content -->
            <div class="main-content">
                <main role="main">
                    @RenderBody()
                </main>
            </div>

            <!-- Footer -->
            <footer class="bg-white border-top text-muted text-center py-3">
                <div class="container">
                    © 2026 - ShopDoora.Web - Admin Dashboard
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
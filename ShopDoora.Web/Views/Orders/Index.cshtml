@model ShopDoora.Web.Models.PagedResult<ShopDoora.Web.Models.OrderViewModel>

@{
    ViewData["Title"] = "Orders Management";
}

<!-- Header Section -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Orders Management</h2>
        <p class="text-muted mb-0">View and track customer orders, items, and total revenue.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-box-seam me-1"></i> Products
        </a>
        <a asp-controller="Orders" asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Place Order
        </a>
    </div>
</div>

<!-- Table Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Order ID</th>
                        <th>Customer</th>
                        <th>Order Date</th>
                        <th>Ordered Items</th>
                        <th class="text-end pe-4">Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        @foreach (var o in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-secondary">#@o.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-person-fill small"></i>
                                        </div>
                                        <span class="fw-medium text-dark">@o.UserEmail</span>
                                    </div>
                                </td>
                                <td class="text-muted small">
                                    <i class="bi bi-calendar3 me-1"></i> @o.OrderDate.ToString("yyyy-MM-dd HH:mm")
                                </td>
                                <td>
                                    <ul class="list-unstyled mb-0 small">
                                        @if (o.Items != null && o.Items.Any())
                                        {
                                            @foreach (var item in o.Items)
                                            {
                                                <li class="py-1 border-bottom border-light">
                                                    <span class="fw-semibold text-dark">@item.ProductName</span> 
                                                    <span class="text-muted">x @item.Quantity</span> 
                                                    <span class="text-success ms-1">($@item.SubTotal.ToString("N2"))</span>
                                                </li>
                                            }
                                        }
                                        else
                                        {
                                            <li class="text-muted italic">No items</li>
                                        }
                                    </ul>
                                </td>
                                <td class="text-end pe-4">
                                    <span class="badge bg-success bg-opacity-10 text-success fs-6 px-3 py-2 fw-bold">
                                        $@o.TotalAmount.ToString("N2")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No orders found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-controller="Orders" asp-action="Index" asp-route-pageNumber="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
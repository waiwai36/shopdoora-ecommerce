@{
    ViewData["Title"] = "Create Order";
    var products = ViewBag.Products as List<ShopDoora.Web.Models.ProductViewModel> ?? new();
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow border-0 rounded-4 p-4">
            
            <div class="d-flex align-items-center mb-4 border-bottom pb-3">
                <div class="bg-success bg-opacity-10 p-3 rounded-3 me-3 text-success">
                    <i class="bi bi-cart-plus fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-0">Create New Order</h3>
                    <p class="text-muted small mb-0">Select quantities for the products you want to order</p>
                </div>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
                    <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post" asp-controller="Orders" asp-action="Create">
                <div class="table-responsive mb-4">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-4">Product Name</th>
                                <th>Price</th>
                                <th>Available Stock</th>
                                <th style="width: 180px;">Order Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (products.Any())
                            {
                                @foreach (var p in products)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="fw-bold text-dark">@p.Name</span>                           
                                            <input type="hidden" name="productIds" value="@p.Id" />
                                        </td>
                                        <td>
                                            <span class="text-success fw-semibold">$@p.Price.ToString("N2")</span>
                                        </td>
                                        <td>
                                            @if (p.Stock > 0)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">@p.Stock available</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1">Out of stock</span>
                                            }
                                        </td>
                                        <td>         
                                         <input type="number" 
                                         name="quantities" 
                                         value="0" 
                                         min="0" 
                                         max="@Math.Max(0, p.Stock)"
                                         class="form-control form-control-sm @(p.Stock == 0 ? "bg-secondary bg-opacity-10 text-muted" : "bg-light")" 
                                         @(p.Stock == 0 ? "readonly" : "") />
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No products available for ordering.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-success px-4 fw-semibold shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Submit Order
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
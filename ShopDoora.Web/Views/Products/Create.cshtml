@model ShopDoora.Web.Models.ProductViewModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-0 rounded-4 p-4">
            
            <!-- Header -->
            <div class="d-flex align-items-center mb-4 border-bottom pb-3">
                <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3 text-primary">
                    <i class="bi bi-box-seam fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-0">Create New Product</h3>
                    <p class="text-muted small mb-0">Add a new item to your store inventory</p>
                </div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
                    <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post" asp-controller="Products" asp-action="Create">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Product Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-tag text-muted"></i></span>
                        <input asp-for="Name" class="form-control border-start-0 bg-light" placeholder="Enter product name" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Description</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 align-items-start pt-2"><i class="bi bi-card-text text-muted"></i></span>
                        <textarea asp-for="Description" class="form-control border-start-0 bg-light" rows="3" placeholder="Enter product description (optional)"></textarea>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold small">Price ($)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-currency-dollar text-muted"></i></span>
                            <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control border-start-0 bg-light" placeholder="0.00" required />
                        </div>
                        <div class="form-text text-muted" style="font-size: 0.75rem;">Must be greater than 0</div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-semibold small">Stock Quantity</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-stack text-muted"></i></span>
                            <input asp-for="Stock" type="number" min="0" class="form-control border-start-0 bg-light" placeholder="0" required />
                        </div>
                        <div class="form-text text-muted" style="font-size: 0.75rem;">Must be 0 or greater</div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Create Product
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>